# =============================================================================
# Agent Server
# Read by: go run ./cmd/aegislink-server
# =============================================================================

# HTTP process and the Agent Server's own PostgreSQL database.
SERVER_ADDRESS=127.0.0.1:4321
SERVER_SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://aegislink:aegislink@127.0.0.1:55432/aegislink?sslmode=disable

# Browser origin accepted by the Agent Server's CORS and origin guard.
WEB_ORIGIN=http://127.0.0.1:5173

# Account sessions. Enable secure cookies when the Web UI is served over HTTPS.
AUTH_SESSION_TTL=24h
AUTH_COOKIE_SECURE=false

# Primary Agent model used for conversations and tool calling.
MODEL_ID=deepseek-primary
MODEL_DRIVER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=
MODEL_TIMEOUT=120s
MODEL_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=8

# Background Curator model. Blank provider/model fields fall back to MODEL_*.
CURATOR_MODEL_ID=
CURATOR_MODEL_DRIVER=
CURATOR_MODEL_BASE_URL=
CURATOR_MODEL_NAME=
CURATOR_MODEL_API_KEY=
CURATOR_MODEL_TIMEOUT=120s
CURATOR_MODEL_MAX_TOKENS=2048
# Curator uses strict JSON and disables DeepSeek thinking by default.
CURATOR_MODEL_JSON_OUTPUT=true
CURATOR_MODEL_THINKING=disabled

# MCP calls made by the Agent Server.
MCP_TIMEOUT=15s
# Keep false outside explicit local MCP development.
MCP_ALLOW_PRIVATE_NETWORKS=false

# AgentFacts signing. Optional for private Profile behavior; required for signed
# publication. Generate a stable Base64 value containing exactly 32 random bytes.
AGENT_KEY_ENCRYPTION_KEY=

# Public origin advertised in collaboration-specific official A2A AgentCards.
# Session capabilities are encrypted under AGENT_KEY_ENCRYPTION_KEY and are
# never returned to the browser or model.
A2A_PUBLIC_BASE_URL=http://127.0.0.1:4321

# -----------------------------------------------------------------------------
# Agent Server -> standalone Index adapter
# These AGENT_INDEX_* values are read by Agent Server, not by the Index process.
# Existing configured accounts can run with this group blank. New-account setup,
# Profile vector publication, and Discovery search require the complete group.
# AGENT_INDEX_*_TOKEN must equal the corresponding INDEX_*_TOKEN below.
# -----------------------------------------------------------------------------
AGENT_INDEX_BASE_URL=
AGENT_INDEX_REGISTRATION_TOKEN=
AGENT_INDEX_QUERY_TOKEN=
AGENT_INDEX_TIMEOUT=15s

# OpenAI-compatible embedding endpoint used by Agent Server. The encoder sees
# public/indexable Profile text; the Index receives only vectors and digests.
# DISCOVERY_ENCODER_API_KEY may stay blank for an unauthenticated local endpoint.
DISCOVERY_ENCODER_BASE_URL=
DISCOVERY_ENCODER_API_KEY=
DISCOVERY_ENCODER_MODEL=
DISCOVERY_ENCODER_TIMEOUT=30s

# =============================================================================
# Standalone Index
# Read by: go run ./index/cmd/aegislink-index
# The Index has its own HTTP process and PostgreSQL/pgvector database. It does
# not read Agent Server model credentials or DATABASE_URL.
# =============================================================================

INDEX_SERVER_ADDRESS=127.0.0.1:4331
INDEX_SERVER_SHUTDOWN_TIMEOUT=10s
INDEX_DATABASE_URL=postgres://aegislink_index:aegislink_index@127.0.0.1:55434/aegislink_index?sslmode=disable

# Controlled-network credentials. Use two different random values of at least
# 32 characters. Copy these values into the matching AGENT_INDEX_* fields above
# when enabling the Agent Server adapter.
INDEX_REGISTRATION_TOKEN=replace-with-at-least-32-random-characters
INDEX_QUERY_TOKEN=replace-with-a-separate-32-character-token

# =============================================================================
# Web / Vite development server
# Read by: pnpm dev:web
# =============================================================================

# Optional: point the Vite /api proxy at a non-default Agent Server instance.
VITE_API_PROXY_TARGET=http://127.0.0.1:4321
