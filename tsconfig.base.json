{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@aegislink/agent-client": ["packages/agent-client/src/index.ts"],
      "@aegislink/storage-core": ["packages/storage-core/src/index.ts"],
      "@aegislink/storage-local": ["packages/storage-local/src/index.ts"],
      "@aegislink/rag-core": ["packages/rag-core/src/index.ts"],
      "@aegislink/vector-chroma": ["packages/vector-chroma/src/index.ts"],
      "@aegislink/crypto-identity": ["packages/crypto-identity/src/index.ts"],
      "@aegislink/permission-core": ["packages/permission-core/src/index.ts"],
      "@aegislink/protocol": ["packages/protocol/src/index.ts"]
    }
  }
}
